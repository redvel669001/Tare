func exit2: {
  syscall(60, 0);
  ret;
}

func exit(u64 exit_code): {
  syscall(60, exit_code);
  ret;
}

func print_num(u64 arg) => (u64 success): {
  // r8
  f(20);
  success = 1;
  
  if (tape): s(tape);
  a((arg % 10) + 48);
  arg = (arg - (arg % 10)) / 10;
  p();

  while (arg > 0): {
    if (tape): s(tape);
    a((arg % 10) + 48);
    arg = (arg - (arg % 10)) / 10;
    p();
  }
  
  f(20);
  if (tape): s(tape);
  a(10);
  n();

  write(base, index);
  ret;
}