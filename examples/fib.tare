func print_fibs2(u64 first, u64 last): {
  a(10);
  write(base, 1);
  if tape: s(tape);
    
  while (first < last): {
    // clean
    f(300);
    while (head + 8 > base + length): p();
    while (head > base): {
      if (tape): s(tape);
      p();
    }
    
    
    // print
    // r8
    print_num(fib_2(0, 0, 0, first));
    // r64
    // inc
    first = first + 1;
  }
  ret;
}

func fib_2(u64 fib1, u64 fib2, u64 buf, u64 ind) => (u64 result): {
  result = 0;

  fib1 = 0;
  fib2 = 1;

  if (ind == 0): {
    result = fib1;
    ret;
  }

  if (ind == 1): {
    result = fib2;
    ret;
  }

  while (1): {
    buf = fib1 + fib2;
    fib1 = fib2;
    fib2 = buf;
    result = result + 1;
    if (result >= ind): break;
  }

  result = buf;
  
  ret;
}

func print_fibs3(u64 first, u64 last): {
  a(10);
  write(base, 1);
  if tape: s(tape);
      
  while (first < last): {
    // clean
    f(300);
    while (head + 8 > base + length): p();
    while (head > base): {
      if (tape): s(tape);
      p();
    }
    
    
    // print
    // r8
    print_num(fib_3(first));
    // r64
    // inc
    first = first + 1;
  }
  ret;
}

func fib_3(u64 ind) => (u64 result): {
  result = 0;

  u64 fib1;
  u64 fib2 = 1;

  // fib1 = 0;
  // fib2 = 1;

  if (ind == 0): {
    result = fib1;
    ret;
  }

  if (ind == 1): {
    result = fib2;
    ret;
  }

  u64 counter = 0;
  // counter = 0;

  while (counter < ind): {
    result = fib1 + fib2;
    fib1 = fib2;
    fib2 = result;
    counter = counter + 1;
  }

  // result = buf;
  
  ret;
}

