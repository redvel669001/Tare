func main => (u64 exit_code): {
  // add_(1, 2);
  exit_code = addition(3, 2);
  exit(14);
  ret;
}

func exit(u64 exit_code): {
  syscall(60, exit_code);
  ret;
}

func addition(u64 x1, u64 x2) => (u64 x3): {
  x3 = x1 - x2;
  ret;
}

